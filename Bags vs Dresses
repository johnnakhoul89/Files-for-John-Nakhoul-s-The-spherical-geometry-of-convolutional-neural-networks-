    ax.set_title(f'$k = {k_val}$ Neighbors', fontsize=13, fontweight='bold')
    ax.set_xlabel('Layer Depth', fontsize=11)
    if i == 0:
        ax.set_ylabel(r'Geometric Delta ($\Delta\kappa$)', fontsize=11)
    ax.set_xticks(layers_x)
    ax.set_xticklabels([f"Layer {j}" for j in layers_x])
    ax.grid(True, linestyle='--', alpha=0.5)

handles, leg_labels = axes[0].get_legend_handles_labels()
fig.legend(handles, leg_labels, loc='upper center', bbox_to_anchor=(0.5, 1.05), ncol=3, frameon=True, fontsize=11)
plt.suptitle('MNIST (1 vs 7): Cross-Architecture Comparison of Geometric Separation', y=1.12, fontsize=15, fontweight='bold')
plt.tight_layout()
plt.show()
